# =============================================================================
# Retail Management System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=your_local_password_here

# JWT (auth-service only)
JWT_SECRET=your_strong_random_secret_here_min_32_chars

# Default Owner Account Seeder (auth-service)
OWNER_DEFAULT_USERNAME=owner
OWNER_DEFAULT_EMAIL=owner@retail.local
OWNER_DEFAULT_PHONE=9999999998
OWNER_DEFAULT_FULL_NAME=Default Owner
OWNER_DEFAULT_PASSWORD=your_strong_owner_password_here

# Development Admin Account Seeder (auth-service)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@retail.local
DEV_ADMIN_PHONE=9999999999
DEV_ADMIN_FULL_NAME=Development Admin
DEV_ADMIN_PASSWORD=your_strong_dev_admin_password_here
