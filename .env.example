# =============================================================================
# Retail Management System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=your_local_password_here

# JWT (auth-service only)
JWT_SECRET=your_strong_random_secret_here_min_32_chars
